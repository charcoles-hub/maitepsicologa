---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import BarraMovil from '../components/BarraMovil.astro';
import { contact, href, ui, type Lang, type PageKey } from '../data/site';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  escena?: boolean;
}

const { lang, page, title, description, escena = false } = Astro.props;
const t = ui[lang];
const preview = !['www.maitepsicologa.com', 'maitepsicologa.com'].includes(Astro.site?.hostname ?? '');
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}og.png`, Astro.site);
const canonical = new URL(href(lang, page), Astro.site);
const alternates = (['es', 'ca'] as const).map((l) => ({ lang: l, url: new URL(href(l, page), Astro.site) }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Psychologist',
  name: 'Maite Vicente Psicología',
  url: new URL(href(lang, 'inicio'), Astro.site).href,
  telephone: '+34613001609',
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Carrer de Roger de Flor, 63, 1º 2ª',
    postalCode: '08401',
    addressLocality: 'Granollers',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '10:00', closes: '21:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '13:00' },
  ],
  areaServed: ['Granollers', 'Vallès Oriental'],
  sameAs: [contact.instagram],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].url} />
    <meta name="theme-color" content="#fbfcfc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches){var r=document.documentElement;r.classList.add('mov');setTimeout(function(){if(!r.classList.contains('mov-listo'))r.classList.remove('mov')},2500)}</script>
  </head>
  <body class:list={{ 'con-escena': escena }}>
    <div class="cielo" aria-hidden="true"></div>
    <div class="sol" aria-hidden="true"></div>
    <a class="saltar" href="#contenido">{t.skip}</a>
    <Cabecera lang={lang} page={page} />
    <main id="contenido">
      <slot />
    </main>
    <Pie lang={lang} />
    <BarraMovil lang={lang} />
    <script>
      import '../scripts/movimiento-premium';
      import '../scripts/dia';
    </script>
  </body>
</html>
