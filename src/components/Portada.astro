---
import { contact, href, label, reviews, ui, type Lang, type PageKey } from '../data/site';
import { especialidades } from '../data/paginas';
import Retrato from './Retrato.astro';
import fotoMaite from '../assets/fotos/maite-escritorio.png';
import fotoMartina from '../assets/fotos/martina.jpg';
import Mapa from './Mapa.astro';
import Faq from './Faq.astro';
import Cierre from './Cierre.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

type Pensamiento = { es: string; ca: string; t: 'l' | 'm' | 's'; d: number; x: number; y: number; xm: number; ym: number; ruta?: number; movil?: boolean };

const pensamientos: Pensamiento[] = [
