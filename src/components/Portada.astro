  { es: 'discutimos por todo', ca: 'discutim per tot', t: 'l', d: 0.9, x: 54, y: 64, xm: 46, ym: 33, ruta: 2, movil: true },
  { es: 'no tengo tiempo de ir a ninguna parte', ca: "no tinc temps d’anar enlloc", t: 's', d: 0.5, x: 63, y: 84, xm: 8, ym: 98, ruta: 3 },
  { es: 'no sé qué me pasa', ca: 'no sé què em passa', t: 'm', d: 0.8, x: 79, y: 30, xm: 58, ym: 24, ruta: 4, movil: true },
  { es: 'todo me supera', ca: 'tot em supera', t: 's', d: 0.4, x: 7, y: 12, xm: 56, ym: 46, movil: true },
  { es: '¿será culpa mía?', ca: 'serà culpa meva?', t: 'm', d: 0.6, x: 34, y: 8, xm: 52, ym: 41, movil: true },
