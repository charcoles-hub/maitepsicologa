  { es: 'mañana se me pasa', ca: 'demà se’m passa', t: 'm', d: 0.5, x: 5, y: 88, xm: 0, ym: 0 },
  { es: 'el pecho me aprieta', ca: "el pit m’oprimeix", t: 's', d: 0.4, x: 31, y: 93, xm: 0, ym: 0 },
  { es: 'ya no somos los de antes', ca: 'ja no som els d’abans', t: 's', d: 0.45, x: 84, y: 60, xm: 0, ym: 0 },
  { es: 'no puedo más', ca: 'no puc més', t: 's', d: 0.3, x: 45, y: 38, xm: 62, ym: 17, movil: true },
