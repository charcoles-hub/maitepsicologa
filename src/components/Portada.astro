---
import { contact, href, reviews, ui, type Lang, type PageKey } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const copy = {
  es: {
    h1: 'Psicología en Granollers y online',
    lead: 'Terapia para adultos, adolescentes, niños, parejas y familias. A tu ritmo, en la consulta o por videollamada.',
    pregunta: '¿Qué te trae?',
    rutas: [
      ['Ansiedad, estrés o no consigo dormir', 'adultos'],
      ['Me preocupa mi hijo o mi hija', 'infantil'],
      ['Discutimos todo el rato', 'pareja'],
      ['Prefiero hacerlo online', 'online'],
      ['No sé muy bien qué me pasa', 'contacto'],
    ] as [string, PageKey][],
    resenasTitulo: 'Lo que dicen quienes ya han venido',
    resenasNota: 'Reseñas publicadas en Google, citadas tal cual.',
    resenasEnlace: 'Ver todas las reseñas en Google',
    pasosTitulo: 'Cómo es empezar',
    pasos: [
      ['Reserva o escríbenos', 'Elige día y hora en la agenda online. Si prefieres hablar antes, llámanos o escríbenos por WhatsApp.'],
      ['La primera sesión', 'Nos cuentas qué te pasa, sin prisas. Son 55 minutos, en la consulta de Granollers o por videollamada.'],
      ['Un plan para ti', 'Acordamos objetivos y frecuencia. Entre sesiones tienes ejercicios adaptados y acceso por WhatsApp.'],
    ],
    equipoTitulo: 'Quién te acompaña',
    maite: 'Licenciada en Psicología (UAB y UOC), con un máster en Psicología Infantil y Juvenil (URJC) y otro en Terapias de Tercera Generación (Universidad Isabel I).',
    enfoques: 'Trabajamos desde la psicología integrativa, la terapia breve estratégica, la sistémica y la cognitivo-conductual.',
    companera: 'PENDIENTE: nombre, formación, número de colegiada y foto de la segunda psicóloga.',
    fotoPendiente: 'PENDIENTE: foto real de Maite.',
    equipoEnlace: 'Conocernos mejor',
    dondeTitulo: 'En la consulta o desde casa',
    presencial: 'Presencial',
    presencialTexto: 'Las sesiones con niños son siempre presenciales.',
    mapa: 'Cómo llegar',
    online: 'Online',
    onlineTexto: 'Por videollamada o teléfono, desde donde estés a gusto. Puedes combinar presencial y online cuando quieras.',
    onlineEnlace: 'Cómo funciona la terapia online',
    tarifasTitulo: 'Tarifas',
    tarifasPendiente: 'PENDIENTE: precios de sesión individual, pareja o familia, online y consulta breve de 30 minutos.',
    tarifasEnlace: 'Ver tarifas',
    cierreTitulo: 'Cuando quieras, empezamos',
    cierreTexto: 'Reserva tu primera sesión o escríbenos y te respondemos lo antes posible.',
  },
  ca: {
    h1: 'Psicologia a Granollers i online',
    lead: "Teràpia per a adults, adolescents, infants, parelles i famílies. Al teu ritme, a la consulta o per videotrucada.",
    pregunta: 'Què et porta aquí?',
    rutas: [
      ["Ansietat, estrès o no aconsegueixo dormir", 'adultos'],
      ['Em preocupa el meu fill o la meva filla', 'infantil'],
      ["Discutim tota l'estona", 'pareja'],
      ['Prefereixo fer-ho online', 'online'],
      ['No sé ben bé què em passa', 'contacto'],
    ] as [string, PageKey][],
    resenasTitulo: 'El que diuen les persones que ja han vingut',
    resenasNota: 'Ressenyes publicades a Google, citades tal com són.',
    resenasEnlace: 'Veure totes les ressenyes a Google',
    pasosTitulo: 'Com és començar',
    pasos: [
      ["Reserva o escriu-nos", "Tria dia i hora a l'agenda online. Si prefereixes parlar abans, truca'ns o escriu-nos per WhatsApp."],
      ['La primera sessió', "Ens expliques què et passa, sense presses. Són 55 minuts, a la consulta de Granollers o per videotrucada."],
      ['Un pla per a tu', "Acordem objectius i freqüència. Entre sessions tens exercicis adaptats i accés per WhatsApp."],
    ],
    equipoTitulo: "Qui t'acompanya",
    maite: "Llicenciada en Psicologia (UAB i UOC), amb un màster en Psicologia Infantil i Juvenil (URJC) i un altre en Teràpies de Tercera Generació (Universidad Isabel I).",
    enfoques: "Treballem des de la psicologia integrativa, la teràpia breu estratègica, la sistèmica i la cognitivoconductual.",
    companera: 'PENDENT: nom, formació, número de col·legiada i foto de la segona psicòloga.',
    fotoPendiente: 'PENDENT: foto real de la Maite.',
    equipoEnlace: "Coneix-nos millor",
    dondeTitulo: 'A la consulta o des de casa',
    presencial: 'Presencial',
    presencialTexto: 'Les sessions amb infants són sempre presencials.',
    mapa: 'Com arribar-hi',
    online: 'Online',
    onlineTexto: "Per videotrucada o telèfon, des d'on estiguis a gust. Pots combinar presencial i online quan vulguis.",
    onlineEnlace: 'Com funciona la teràpia online',
    tarifasTitulo: 'Tarifes',
    tarifasPendiente: 'PENDENT: preus de sessió individual, parella o família, online i consulta breu de 30 minuts.',
    tarifasEnlace: 'Veure tarifes',
    cierreTitulo: 'Quan vulguis, comencem',
    cierreTexto: 'Reserva la teva primera sessió o escriu-nos i et respondrem al més aviat possible.',
  },
}[lang];

const fecha = (iso: string) =>
  new Intl.DateTimeFormat(lang === 'ca' ? 'ca-ES' : 'es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));

const [destacada, ...resto] = reviews;
const googleReviews = 'https://www.google.com/maps/search/?api=1&query=Maite+Vicente+Psic%C3%B3loga+Granollers';
const mapa = 'https://www.google.com/maps/search/?api=1&query=Carrer+de+Roger+de+Flor+63+08401+Granollers';
---
<section class="portada contenedor" aria-labelledby="portada-titulo">
  <div class="portada__texto">
    <h1 id="portada-titulo">{copy.h1}</h1>
    <p class="portada__lead">{copy.lead}</p>
    <div class="portada__acciones">
      <a class="boton" href={contact.setmore} target="_blank" rel="noopener">{t.cta}</a>
      <a class="enlace" href={contact.phoneHref}>{t.callFull}</a>
    </div>
  </div>

  <nav class="rutas" aria-labelledby="rutas-titulo">
    <h2 id="rutas-titulo" class="rutas__pregunta">{copy.pregunta}</h2>
    <ul>
      {copy.rutas.map(([texto, key], i) => (
        <li style={`--i:${i}`}><a href={href(lang, key)}>{texto}</a></li>
      ))}
    </ul>
  </nav>

  <figure class="portada__resena">
    <blockquote lang={destacada.lang}><p>«{destacada.text}»</p></blockquote>
    <figcaption>{destacada.name}, en Google · <time datetime={destacada.date}>{fecha(destacada.date)}</time></figcaption>
  </figure>
</section>

<section class="resenas" aria-labelledby="resenas-titulo">
  <div class="contenedor">
    <h2 id="resenas-titulo">{copy.resenasTitulo}</h2>
    <div class="resenas__lista">
      {resto.map((r) => (
        <figure class="resena">
          <blockquote lang={r.lang}><p>«{r.text}»</p></blockquote>
          <figcaption>{r.name} · <time datetime={r.date}>{fecha(r.date)}</time></figcaption>
        </figure>
      ))}
    </div>
    <p class="resenas__pie">
      {copy.resenasNota}
      <!-- PENDIENTE: enlace directo a la ficha de Google de la consulta -->
      <a class="enlace" href={googleReviews} target="_blank" rel="noopener">{copy.resenasEnlace}</a>
    </p>
  </div>
</section>

<section class="pasos contenedor" aria-labelledby="pasos-titulo">
  <h2 id="pasos-titulo">{copy.pasosTitulo}</h2>
  <ol>
    {copy.pasos.map(([titulo, texto]) => (
      <li>
        <h3>{titulo}</h3>
        <p>{texto}</p>
      </li>
    ))}
  </ol>
</section>

<section class="equipo contenedor" aria-labelledby="equipo-titulo">
  <h2 id="equipo-titulo">{copy.equipoTitulo}</h2>
  <div class="equipo__rejilla">
    <article class="persona persona--principal">
      <div class="persona__foto pendiente">{copy.fotoPendiente}</div>
      <div>
        <h3>Maite Vicente Pérez</h3>
        <p class="persona__dato">{t.colegiada}</p>
        <p>{copy.maite}</p>
        <p>{copy.enfoques}</p>
      </div>
    </article>
    <article class="persona">
      <p class="pendiente">{copy.companera}</p>
    </article>
  </div>
  <p><a class="enlace" href={href(lang, 'nosotras')}>{copy.equipoEnlace}</a></p>
</section>

<section class="donde contenedor" aria-labelledby="donde-titulo">
  <h2 id="donde-titulo">{copy.dondeTitulo}</h2>
  <div class="donde__rejilla">
    <div class="donde__bloque">
      <h3>{copy.presencial}</h3>
      <address>{contact.address.map((l) => <span>{l}<br /></span>)}</address>
      <p class="cifra">{contact.hours[lang].map((l) => <span>{l}<br /></span>)}</p>
      <p>{copy.presencialTexto}</p>
      <a class="boton boton--secundario" href={mapa} target="_blank" rel="noopener">{copy.mapa}</a>
    </div>
    <div class="donde__bloque">
      <h3>{copy.online}</h3>
      <p>{copy.onlineTexto}</p>
      <p><a class="enlace" href={href(lang, 'online')}>{copy.onlineEnlace}</a></p>
    </div>
  </div>
</section>

<section class="tarifas contenedor" aria-labelledby="tarifas-titulo">
  <h2 id="tarifas-titulo">{copy.tarifasTitulo}</h2>
  <p class="pendiente">{copy.tarifasPendiente}</p>
  <p><a class="enlace" href={href(lang, 'tarifas')}>{copy.tarifasEnlace}</a></p>
</section>

<section class="cierre contenedor" aria-labelledby="cierre-titulo">
  <h2 id="cierre-titulo">{copy.cierreTitulo}</h2>
  <p>{copy.cierreTexto}</p>
  <div class="cierre__acciones">
    <a class="boton" href={contact.setmore} target="_blank" rel="noopener">{t.cta}</a>
    <a class="boton boton--secundario" href={contact.whatsapp[lang]} target="_blank" rel="noopener">{t.whatsappFull}</a>
  </div>
</section>

<style>
  section h2 { font-size: var(--t-titulo); margin-bottom: var(--e-l); }

  .portada {
    display: grid;
    grid-template-columns: 5fr 7fr;
    grid-template-areas:
      'texto rutas'
      'resena resena';
    gap: var(--e-xl) clamp(32px, 6vw, 96px);
    padding-top: clamp(40px, 7vw, 96px);
  }
  .portada__texto { grid-area: texto; align-self: start; }
  .portada h1 { font-size: var(--t-display); font-weight: 650; line-height: 1.04; letter-spacing: -0.025em; }
  .portada__lead { margin-top: var(--e-l); color: var(--texto-suave); font-size: 1.15rem; max-width: 34ch; }
  .portada__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-m) var(--e-l); margin-top: var(--e-xl); }

  .rutas { grid-area: rutas; }
  .rutas__pregunta { font-size: 1.05rem; font-weight: 650; color: var(--texto-suave); letter-spacing: 0; margin-bottom: var(--e-s); }
  .rutas ul { list-style: none; padding: 0; border-bottom: 1px solid var(--linea); }
  .rutas li { border-top: 1px solid var(--linea); animation: entra 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i) * 60ms + 120ms); }
  .rutas a {
    display: flex;
    align-items: center;
    min-height: 64px;
    padding-block: var(--e-m);
    font-size: var(--t-ruta);
    font-weight: 520;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--texto);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.2s ease, color 0.2s ease;
  }
  .rutas a:hover, .rutas a:focus-visible { color: var(--acento); text-decoration-color: var(--acento); }
  @keyframes entra { from { opacity: 0; transform: translateY(8px); } }

  .portada__resena {
    grid-area: resena;
    border-left: 0;
    padding: var(--e-l) 0 0;
    border-top: 1px solid var(--linea);
    max-width: 60ch;
  }
  blockquote p { font-family: var(--voz); font-style: italic; font-size: var(--t-voz); line-height: 1.4; }
  figcaption { margin-top: var(--e-s); color: var(--texto-suave); font-size: var(--t-pequeno); }

  .resenas { margin-top: var(--e-xxl); padding-block: var(--e-xxl); background: var(--superficie); }
  .resenas__lista { display: grid; grid-template-columns: 1fr 1fr; gap: var(--e-xl); }
  .resena blockquote p { font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); }
  .resenas__pie { margin-top: var(--e-xl); color: var(--texto-suave); font-size: var(--t-pequeno); display: flex; flex-wrap: wrap; gap: var(--e-s) var(--e-l); }

  .pasos { padding-top: var(--e-xxl); }
  .pasos ol { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--e-xl); counter-reset: paso; }
  .pasos li { counter-increment: paso; border-top: 2px solid var(--acento); padding-top: var(--e-m); }
  .pasos li::before { content: counter(paso); display: block; font-weight: 700; color: var(--acento); margin-bottom: var(--e-s); }
  .pasos h3 { font-size: 1.3rem; margin-bottom: var(--e-s); }
  .pasos p { color: var(--texto-suave); }

  .equipo { padding-top: var(--e-xxl); }
  .equipo__rejilla { display: grid; grid-template-columns: 7fr 5fr; gap: var(--e-xl); align-items: start; margin-bottom: var(--e-l); }
  .persona--principal { display: grid; grid-template-columns: 180px 1fr; gap: var(--e-l); }
  .persona__foto { aspect-ratio: 4 / 5; display: grid; place-items: center; text-align: center; }
  .persona h3 { font-size: 1.4rem; }
  .persona__dato { color: var(--acento); font-weight: 600; margin-bottom: var(--e-s); }
  .persona p + p { margin-top: var(--e-s); }

  .donde { padding-top: var(--e-xxl); }
  .donde__rejilla { display: grid; grid-template-columns: 1fr 1fr; gap: var(--e-l); }
  .donde__bloque { border: 1px solid var(--linea); border-radius: var(--r-m); padding: var(--e-l); display: flex; flex-direction: column; align-items: flex-start; gap: var(--e-m); }
  .donde__bloque h3 { font-size: 1.3rem; }
  .donde address { font-style: normal; }

  .tarifas { padding-top: var(--e-xxl); }
  .tarifas .pendiente { margin-bottom: var(--e-m); }

  .cierre { padding-top: var(--e-xxl); text-align: center; }
  .cierre p { color: var(--texto-suave); max-width: 46ch; margin-inline: auto; }
  .cierre__acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--e-m); margin-top: var(--e-l); }

  @media (max-width: 860px) {
    .portada { grid-template-columns: 1fr; grid-template-areas: 'texto' 'rutas' 'resena'; gap: var(--e-xl); }
    .portada__acciones { margin-top: var(--e-l); }
    .resenas__lista, .pasos ol, .equipo__rejilla, .donde__rejilla { grid-template-columns: 1fr; }
    .persona--principal { grid-template-columns: 120px 1fr; }
  }
  @media (max-width: 480px) {
    .persona--principal { grid-template-columns: 1fr; }
    .persona__foto { max-width: 200px; }
  }
</style>
