---
import { ui, type Lang } from '../data/site';
import { enfoques, formacion } from '../data/paginas';
import SubHero from './SubHero.astro';
import Retrato from './Retrato.astro';
import fotoMaite from '../assets/fotos/maite-sofa.png';
import fotoMartina from '../assets/fotos/martina.jpg';
import fotoSala from '../assets/fotos/consulta-sala.png';
import fotoMesa from '../assets/fotos/consulta-mesa.png';
import fotoDetalle from '../assets/fotos/consulta-detalle.png';
import Cierre from './Cierre.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const c = {
  es: {
    h1: 'Sobre nosotras',
    intro: 'Una consulta pequeña en Granollers, también online. Aquí cada persona tiene su tiempo y sabe en todo momento qué estamos haciendo y por qué.',
    maite: 'Licenciada en Psicología en 2014, trabaja con adultos, adolescentes, niños, parejas y familias en su consulta de Granollers y por videollamada. Se ha especializado en infancia y adolescencia y en las terapias de tercera generación.',
    formacion: 'Formación',
    companera: [
      'Psicóloga especializada en ansiedad, autoestima y dependencia emocional. Acompaña a personas que sienten que el malestar emocional, la inseguridad o algunas relaciones están interfiriendo en su día a día.',
      'Trabaja sobre todo desde la terapia cognitivo-conductual, con herramientas prácticas para entender qué está pasando, ver los patrones que mantienen el malestar y encontrar nuevas formas de afrontarlo: la gestión de las emociones, los pensamientos repetitivos, poner límites, el miedo al rechazo o la dependencia en las relaciones. Atiende en la consulta de Granollers y online.',
    ],
    foto: 'Foto pendiente',
    fotoMaite: 'Retrato de Maite en la consulta.',
    altMaite: 'Maite Vicente tomando notas, sentada en un sofá.',
    fotoCompanera: 'Retrato de Martina en la consulta.',
    altCompanera: 'Martina Pages, con gafas y americana negra, sentada a su mesa.',
    enfoquesTitulo: 'Cómo trabajamos',
    espacioTitulo: 'La consulta',
    espacioIntro: 'Carrer de Roger de Flor, 63, 1º 2ª, en Granollers. Un espacio tranquilo para hablar sin prisas.',
    espacio: ['Sala de la consulta: sofá beige con cojines rosa, butaca rosa, alfombra de yute y una ventana grande con cortinas claras.', 'Mesa de trabajo blanca con dos sillas, un ramo de flores granate y una lámpara rosa encendida.', 'Detalle de la mesa: una libreta, una vela encendida y flores.'],
  },
  ca: {
    h1: 'Sobre nosaltres',
    intro: 'Una consulta petita a Granollers, també online. Aquí cada persona té el seu temps i sap en tot moment què estem fent i per què.',
    maite: "Llicenciada en Psicologia el 2014, treballa amb adults, adolescents, infants, parelles i famílies a la seva consulta de Granollers i per videotrucada. S’ha especialitzat en infància i adolescència i en les teràpies de tercera generació.",
    formacion: 'Formació',
    companera: [
      'Psicòloga especialitzada en ansietat, autoestima i dependència emocional. Acompanya persones que senten que el malestar emocional, la inseguretat o algunes relacions estan interferint en el seu dia a dia.',
      'Treballa sobretot des de la teràpia cognitivoconductual, amb eines pràctiques per entendre què està passant, veure els patrons que mantenen el malestar i trobar noves maneres d’afrontar-lo: la gestió de les emocions, els pensaments repetitius, posar límits, la por al rebuig o la dependència en les relacions. Atén a la consulta de Granollers i online.',
    ],
    foto: 'Foto pendent',
    fotoMaite: 'Retrat de la Maite a la consulta.',
    altMaite: 'La Maite Vicente prenent notes, asseguda en un sofà.',
    fotoCompanera: 'Retrat de la Martina a la consulta.',
    altCompanera: 'La Martina Pages, amb ulleres i americana negra, asseguda a la seva taula.',
    enfoquesTitulo: 'Com treballem',
    espacioTitulo: 'La consulta',
    espacioIntro: 'Carrer de Roger de Flor, 63, 1r 2a, a Granollers. Un espai tranquil per parlar sense presses.',
    espacio: ['Sala de la consulta: sofà beix amb coixins roses, butaca rosa, catifa de jute i una finestra gran amb cortines clares.', 'Taula de treball blanca amb dues cadires, un ram de flors granat i un llum rosa encès.', 'Detall de la taula: una llibreta, una espelma encesa i flors.'],
  },
}[lang];
---
<SubHero lang={lang} page="nosotras" hora="tarde" h1={c.h1} intro={c.intro} />

<!-- PENDIENTE: Maite valida la biografía; colegiada y días de Martina; fotos de recepción y portal -->
<section class="perfil" data-hora="tarde" aria-labelledby="perfil-maite">
  <div class="contenedor perfil__rejilla">
    <Retrato iniciales="MV" etiqueta={c.foto} pie={c.fotoMaite} foto={fotoMaite} alt={c.altMaite} />
    <div>
      <h2 id="perfil-maite" class="perfil__nombre">Maite Vicente Pérez</h2>
      <p class="perfil__dato">{t.colegiada}</p>
      <p class="perfil__bio">{c.maite}</p>
      <h3 class="perfil__sub">{c.formacion}</h3>
      <ul class="perfil__formacion">
        {formacion[lang].map(([titulo, lugar]) => <li><span>{titulo}</span>{lugar && <span>{lugar}</span>}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="perfil" data-hora="ocaso" aria-labelledby="perfil-companera">
  <div class="contenedor perfil__rejilla perfil__rejilla--invertida">
    <div>
      <h2 id="perfil-companera" class="perfil__nombre perfil__nombre--sola">Martina Pages</h2>
      {c.companera.map((p) => <p class="perfil__bio">{p}</p>)}
    </div>
    <Retrato iniciales="MP" etiqueta={c.foto} pie={c.fotoCompanera} foto={fotoMartina} alt={c.altCompanera} />
  </div>
</section>

<section class="enfoques" data-hora="manana" aria-labelledby="enfoques-titulo">
  <div class="contenedor">
    <h2 id="enfoques-titulo" class="titular-seccion">{c.enfoquesTitulo}</h2>
    <dl class="enfoques__lista">
      {enfoques[lang].map(([n, d]) => (
        <div data-sube>
          <dt>{n}</dt>
          <dd>{d}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="espacio" data-hora="mediodia" aria-labelledby="espacio-titulo">
  <div class="contenedor">
    <h2 id="espacio-titulo" class="titular-seccion">{c.espacioTitulo}</h2>
    <p class="espacio__intro">{c.espacioIntro}</p>
    <div class="espacio__fotos">
      {[fotoSala, fotoMesa, fotoDetalle].map((f, i) => <Retrato iniciales="" etiqueta={c.foto} pie="" foto={f} alt={c.espacio[i]} formato={i === 0 ? 'apaisado' : 'retrato'} sizes={i === 0 ? '(min-width: 860px) 560px, 92vw' : '(min-width: 860px) 340px, 46vw'} />)}
    </div>
  </div>
</section>

<Cierre lang={lang} />

<style>
  .perfil__rejilla { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--e-xl) clamp(32px, 6vw, 96px); align-items: center; }
  .perfil__rejilla--invertida { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
  .perfil__nombre { font-size: clamp(2.2rem, 1.4rem + 3vw, 4.4rem); font-weight: 480; letter-spacing: -0.04em; line-height: 1; }
  .perfil__dato { color: var(--acento); font-weight: 600; margin: var(--e-s) 0 var(--e-l); }
  .perfil__nombre--sola { margin-bottom: var(--e-l); }
  .perfil__bio + .perfil__bio { margin-top: var(--e-s); }
  .perfil__bio { font-size: 1.2rem; max-width: 52ch; }
  .perfil__sub { font-size: 1.05rem; letter-spacing: 0; margin: var(--e-xl) 0 var(--e-s); }
  .perfil__formacion { list-style: none; padding: 0; }
  .perfil__formacion li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 var(--e-l); padding-block: var(--e-s); border-top: 1px solid color-mix(in srgb, var(--texto) 14%, transparent); }
  .perfil__formacion li span:last-child:not(:first-child) { color: var(--texto-suave); }

  .enfoques__lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--e-xl) clamp(32px, 6vw, 96px); }
  .enfoques__lista dt { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.6rem); font-weight: 480; letter-spacing: -0.035em; line-height: 1.05; margin-bottom: var(--e-s); }
  .enfoques__lista dd { margin: 0; color: var(--texto-suave); max-width: 44ch; font-size: 1.1rem; }

  .espacio__intro { max-width: 52ch; font-size: 1.15rem; margin: calc(-1 * var(--e-l)) 0 var(--e-xl); color: var(--texto-suave); }
  .espacio__fotos { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr); gap: var(--e-l); align-items: start; }
  .espacio__fotos :global(.retrato--retrato .retrato__marco) { aspect-ratio: 5 / 6; }

  @media (max-width: 860px) {
    .perfil__rejilla, .perfil__rejilla--invertida, .enfoques__lista { grid-template-columns: 1fr; }
    .espacio__fotos { grid-template-columns: 1fr 1fr; }
    .espacio__fotos :global(.retrato--apaisado) { grid-column: 1 / -1; }
    .perfil :global(.retrato) { max-width: 300px; }
  }
</style>
