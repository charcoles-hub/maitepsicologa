---
import { contact, ui, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  titulo?: string;
  texto?: string;
}

const { lang } = Astro.props;
const t = ui[lang];
const titulo = Astro.props.titulo ?? (lang === 'ca' ? 'Quan vulguis, comencem' : 'Cuando quieras, empezamos');
const texto = Astro.props.texto ?? (lang === 'ca' ? 'Reserva la teva primera sessió o escriu-nos i et respondrem al més aviat possible.' : 'Reserva tu primera sesión o escríbenos y te respondemos lo antes posible.');
---
<section class="cierre" aria-labelledby="cierre-titulo">
  <div class="contenedor">
    <h2 id="cierre-titulo" data-enciende>{titulo}</h2>
    <p>{texto}</p>
    <div class="cierre__acciones">
      <a class="boton boton--claro" href={contact.setmore} target="_blank" rel="noopener" data-iman>{t.cta}</a>
      <a class="boton boton--contorno-claro" href={contact.whatsapp[lang]} target="_blank" rel="noopener">{t.whatsappFull}</a>
    </div>
  </div>
</section>

<style>
  .cierre {
    position: relative;
    z-index: 1;
    padding-block: clamp(80px, 12vw, 160px);
    background: var(--acento);
    color: var(--sobre-acento);
    text-align: center;
  }
  .cierre h2 { font-size: clamp(2.6rem, 1.4rem + 5vw, 6rem); font-weight: 480; letter-spacing: -0.045em; line-height: 1; margin: 0 auto var(--e-l); max-width: 14ch; }
  .cierre p { max-width: 46ch; margin-inline: auto; font-size: 1.15rem; color: color-mix(in srgb, var(--sobre-acento) 88%, var(--acento)); }
  .cierre__acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--e-m); margin-top: var(--e-xl); }
</style>
